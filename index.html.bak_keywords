document.getElementById('btnAnalisisCompleto').onclick = () => {
    const contenido = document.getElementById('contenido')?.innerText || '';
    if (!contenido || contenido === '—') { showToast('⚠️ Realiza una investigación primero', true); return; }
    const stats = rustWASM.contarPalabras(contenido);
    const citas = (contenido.match(/\([A-ZÁÉÍÓÚ][a-záéíóú]+,\s*\d{4}\)/g) || []).length;
    const intro = contenido.match(/Introducción:([\s\S]*?)(?=Desarrollo:|Conclusión:|$)/i);
    const des = contenido.match(/Desarrollo:([\s\S]*?)(?=Conclusión:|$)/i);
    const con = contenido.match(/Conclusión:([\s\S]*?)$/i);
    mostrarModal('📊 Análisis Completo',
        `📝 Palabras: ${stats.palabras}\n🔄 Únicas: ${stats.unicas}\n📖 Oraciones: ${stats.oraciones}\n📚 Citas APA: ${citas}\n\n📖 Introducción: ${intro ? rustWASM.contarPalabras(intro[1]).palabras : 0} palabras\n🔬 Desarrollo: ${des ? rustWASM.contarPalabras(des[1]).palabras : 0} palabras\n📊 Conclusión: ${con ? rustWASM.contarPalabras(con[1]).palabras : 0} palabras\n\n🌐 Idioma: ${rustWASM.idioma(contenido)}\n📚 Riqueza léxica: ${stats.palabras > 0 ? Math.round(stats.unicas / stats.palabras * 100) : 0}%\n\n🔌 Agent-Reach: ${agentReach.stats.github + agentReach.stats.reddit + agentReach.stats.wiki} resultados\n🧬 Core 403M: ${core403M.consultas} consultas\n⚡ Multi-IA: ${iaOkCount} respuestas OK · ${iaFailsCount} fallos`
    );
};
