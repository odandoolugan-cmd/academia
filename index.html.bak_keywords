};

// ============================================
// 🔧 FETCH CON TIMEOUT
// ============================================
function fetchConTimeout(url, opciones = {}, timeoutMs = 8000) {
    const ctrl = new AbortController();
    const tid = setTimeout(() => ctrl.abort(), timeoutMs);
    return fetch(url, { ...opciones, signal: ctrl.signal }).finally(() => clearTimeout(tid));
}

const nombreIdioma = {'es':'Español','en':'Inglés','de':'Alemán','fr':'Francés','pt':'Portugués','it':'Italiano'};
const banderaIdioma = {'es':'🇪🇸','en':'🇬🇧','de':'🇩🇪','fr':'🇫🇷','pt':'🇵🇹','it':'🇮🇹'};
