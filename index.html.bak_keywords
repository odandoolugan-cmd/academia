<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>AcadémIA Pro · WASM Rust · Core 403M · Multi-IA · ♾️</title>
    <style>
        *{margin:0;padding:0;box-sizing:border-box}
        body{
            font-family:'Segoe UI',system-ui,sans-serif;
            background:linear-gradient(135deg,#0a0f1e 0%,#0c1222 50%,#0a0f1e 100%);
            color:#eef2ff;min-height:100vh;padding:1rem;overflow-x:hidden;
        }
        .app{max-width:1280px;margin:0 auto}

        /* HEADER */
        .header{text-align:center;margin-bottom:1.5rem}
        h1{
            font-size:2rem;
            background:linear-gradient(135deg,#FFD166,#FF6B6B,#4ECDC4,#8B5CF6);
            -webkit-background-clip:text;background-clip:text;color:transparent;
            display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:6px;
            line-height:1.3;
        }
        .badge{
            padding:3px 10px;border-radius:20px;font-size:.58rem;font-weight:700;
            display:inline-block;letter-spacing:.3px;
        }
        .b-experto{background:linear-gradient(90deg,#8b5cf6,#ec4899);color:#fff}
        .b-basico{background:linear-gradient(90deg,#f97316,#dc2626);color:#fff}
        .b-12f{background:linear-gradient(90deg,#10b981,#059669);color:#fff;animation:glow 2s infinite}
        .b-decide{background:linear-gradient(90deg,#8b5cf6,#ec4899);color:#fff;animation:glow 2s infinite}
        .b-alemania{background:linear-gradient(90deg,#000,#DD0000,#FFCC00);color:#fff}
        .b-wasm{background:#f59e0b;color:#000;animation:pulse 1.5s infinite}
        .b-core{background:linear-gradient(90deg,#8b5cf6,#f59e0b,#ec4899);color:#fff;animation:glow 2s infinite}
        .b-agent{background:linear-gradient(90deg,#f59e0b,#8b5cf6);color:#fff;animation:pulse 1.5s infinite}
        .b-multiia{background:linear-gradient(90deg,#10b981,#3b82f6);color:#fff;animation:glow 2s infinite}
        .b-multi{background:linear-gradient(90deg,#3b82f6,#8b5cf6);color:#fff;animation:glow 2s infinite}
        .b-analytics{background:linear-gradient(90deg,#10b981,#f59e0b);color:#fff;animation:glow 2s infinite}
        .b-1llamada{background:linear-gradient(90deg,#ec4899,#f59e0b,#10b981);color:#fff;animation:glow 2s infinite}
        .b-100f{background:linear-gradient(90deg,#8b5cf6,#ec4899,#f59e0b);color:#fff;animation:glow 2s infinite}
        .b-agente{background:linear-gradient(90deg,#f59e0b,#8b5cf6,#ec4899);color:#fff;animation:glow 2s infinite}
        .b-ilim{background:linear-gradient(90deg,#ec4899,#f59e0b,#10b981,#3b82f6,#8b5cf6);color:#fff;animation:glow 2s infinite}
        @keyframes pulse{0%,100%{box-shadow:0 0 10px #f59e0b}50%{box-shadow:0 0 25px #f59e0b}}
        @keyframes glow{0%,100%{box-shadow:0 0 10px #8b5cf6}50%{box-shadow:0 0 20px #ec4899}}
        .sub{color:#94a3b8;margin-top:.6rem;font-size:.72rem;line-height:1.6;padding:0 1rem}
        .daily{
            background:rgba(139,92,246,.15);border-radius:1rem;padding:.8rem 1rem;
            margin:1rem auto;text-align:center;max-width:90%;
            border-left:3px solid #8b5cf6;border-right:3px solid #8b5cf6;
            font-size:.78rem;color:#c4b5fd;
        }

        /* STATUS BARS */
        .status-strip{display:flex;flex-direction:column;gap:.5rem;margin-bottom:1rem}
        .status-row{
            background:rgba(15,23,42,.6);border-radius:.75rem;padding:.5rem .8rem;
            font-size:.62rem;display:flex;flex-wrap:wrap;gap:8px;align-items:center;
            border:1px solid rgba(139,92,246,.3);
        }
        .status-row.rust{border-color:rgba(206,66,43,.5);background:rgba(206,66,43,.08)}
        .status-row.core{border-color:rgba(139,92,246,.4)}
        .status-row.ar{border-color:rgba(245,158,11,.4);background:rgba(245,158,11,.06)}
        .status-row strong{color:#eef2ff}
        .status-row .ok{color:#10b981;font-weight:bold}
        .status-row .bad{color:#ef4444;font-weight:bold}
        .status-row .lbl{color:#a78bfa;font-weight:600}
        .status-row .item{
            background:rgba(0,0,0,.3);padding:3px 9px;border-radius:10px;
            display:inline-flex;align-items:center;gap:4px;
        }

        /* MODE + BADGES */
        .top-bar{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:1rem}
        .mode-group{display:flex;gap:.35rem;background:rgba(15,23,42,.6);padding:.25rem;border-radius:.6rem;border:1px solid rgba(139,92,246,.3)}
        .mode-btn{background:transparent;border:none;color:#94a3b8;padding:.45rem .9rem;border-radius:.4rem;font-size:.72rem;font-weight:700;cursor:pointer;transition:.15s}
        .mode-btn.active{background:linear-gradient(90deg,#8b5cf6,#3b82f6);color:#fff}
        .info-badges{display:flex;gap:.5rem;flex-wrap:wrap}
        .info-badge{
            background:rgba(15,23,42,.6);border:1px solid rgba(139,92,246,.3);
            color:#c4b5fd;padding:.4rem .85rem;border-radius:.6rem;
            font-size:.68rem;font-weight:600;
        }
        .info-badge.provider{border-color:rgba(16,185,129,.5);color:#6ee7b7}

        body.modo-cientifico .notice{border-left-color:#3b82f6;background:rgba(59,130,246,.15)}
        body.modo-cientifico .badge.b-aristo{opacity:.3}
        .info-badge.cientifico{border-color:rgba(59,130,246,.5);color:#93c5fd;background:rgba(59,130,246,.15)}

        /* PROGRESS */
        .progress-track{width:100%;height:4px;background:rgba(30,41,59,.8);border-radius:2px;overflow:hidden;margin-bottom:1rem}
        .progress-fill{height:100%;width:0;background:linear-gradient(90deg,#8b5cf6,#ec4899);transition:width .5s;border-radius:2px}

        /* MAIN CARD */
        .main-card{
            background:rgba(30,41,59,.6);backdrop-filter:blur(10px);
            border-radius:1.5rem;padding:1.5rem;margin-bottom:1rem;
            border:1px solid rgba(139,92,246,.3);
            box-shadow:0 0 40px rgba(139,92,246,.08);
        }

        /* WORD SECTION */
        .word-section{
            background:rgba(15,23,42,.6);border-radius:1rem;padding:1rem;
            margin-bottom:1rem;border:1px solid rgba(139,92,246,.3);
        }
        .word-title{font-size:.85rem;font-weight:700;margin-bottom:.75rem;color:#a78bfa;display:flex;align-items:center;gap:8px}
        .word-bar{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
        .word-btn{
            background:#1e293b;border:1px solid #334155;padding:8px 16px;
            border-radius:20px;font-size:.72rem;cursor:pointer;font-weight:600;
            color:#94a3b8;transition:.2s;
        }
        .word-btn:hover{background:#334155;color:#fff;border-color:#8b5cf6}
        .word-btn.primary{background:linear-gradient(90deg,#8b5cf6,#3b82f6);color:#fff;border:none}
        .word-btn.primary:hover{transform:scale(1.02)}
        .word-btn.success{background:linear-gradient(90deg,#10b981,#059669);color:#fff;border:none}
        .word-btn:disabled{opacity:.4;cursor:not-allowed}
        .word-status{font-size:.68rem;color:#10b981;margin-left:8px}

            background:rgba(15,23,42,.6);border-radius:1rem;padding:1rem;
            margin-bottom:1rem;border:1px solid rgba(139,92,246,.3);
        }
        .url-title{font-size:.85rem;font-weight:700;margin-bottom:.75rem;color:#a78bfa;display:flex;align-items:center;gap:8px}
        .url-bar{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
        .url-input{
            flex:1;min-width:250px;padding:.75rem;background:#1e293b;
            border:1px solid #334155;border-radius:.6rem;color:#fff;
            font-size:.8rem;transition:.2s;
        }
        .url-input:focus{outline:none;border-color:#8b5cf6;box-shadow:0 0 0 3px rgba(139,92,246,.15)}
        .url-input::placeholder{color:#64748b}
            background:#1e293b;border:1px solid #334155;padding:8px 16px;
            border-radius:20px;font-size:.72rem;cursor:pointer;font-weight:600;
            color:#94a3b8;transition:.2s;
        }
        .url-status{font-size:.68rem;color:#10b981;margin-left:8px}

        /* TOOLBAR */
        .toolbar{display:flex;flex-wrap:wrap;gap:6px;margin:15px 0;justify-content:center}
        .tool{
            background:#1e293b;border:1px solid #334155;padding:6px 12px;
            border-radius:20px;font-size:.68rem;cursor:pointer;font-weight:500;
            color:#94a3b8;transition:.2s;
        }
        .tool:hover{background:#8b5cf6;color:#fff;border-color:#8b5cf6;transform:scale(1.03)}
        .tool.rust{border-color:#ce422b;color:#ff8878;background:rgba(206,66,43,.15)}
        .tool.rust:hover{background:linear-gradient(90deg,#ce422b,#ff6b3d);color:#fff}
        .tool.multiia{border-color:#10b981;color:#34d399;background:rgba(16,185,129,.15)}
        .tool.multiia:hover{background:linear-gradient(90deg,#10b981,#3b82f6);color:#fff}
        .tool.core{border-color:#8b5cf6;color:#a78bfa;background:rgba(139,92,246,.2)}
        .tool.core:hover{background:linear-gradient(90deg,#8b5cf6,#f59e0b,#ec4899);color:#fff}
        .tool.agent{border-color:#f59e0b;color:#fbbf24;background:rgba(245,158,11,.15)}
        .tool.agent:hover{background:linear-gradient(90deg,#f59e0b,#8b5cf6);color:#fff}
        .tool.ilim{border-color:#f59e0b;color:#fbbf24;background:#1e293b}
        .tool.ilim:hover{background:linear-gradient(90deg,#f59e0b,#d97706);color:#fff}
        .tool.f12{border-color:#10b981;color:#34d399;background:#1e293b}
        .tool.f12:hover{background:linear-gradient(135deg,#10b981,#059669);color:#fff}

        /* INPUT */
        .input-row{display:flex;gap:1rem;flex-wrap:wrap;margin-bottom:1rem}
        .input-text{
            flex:1;min-width:200px;padding:1rem;background:#1e293b;
            border:1px solid #334155;border-radius:1rem;color:#fff;
            font-size:.95rem;transition:.2s;
        }
        .input-text:focus{outline:none;border-color:#8b5cf6;box-shadow:0 0 0 3px rgba(139,92,246,.15)}
        .input-text::placeholder{color:#64748b}
        .btn-main{
            background:linear-gradient(90deg,#8b5cf6,#3b82f6);border:none;
            padding:1rem 2rem;border-radius:1rem;color:#fff;font-weight:700;
            cursor:pointer;font-size:.9rem;transition:.2s;letter-spacing:.3px;
        }
        .btn-main:hover:not(:disabled){transform:scale(1.03);box-shadow:0 0 25px rgba(139,92,246,.4)}
        .btn-main:disabled{opacity:.5;cursor:not-allowed}

        /* NOTICE */
        .notice{
            background:rgba(59,130,246,.1);border-left:4px solid #3b82f6;
            border-radius:.8rem;padding:.8rem 1rem;margin-bottom:1rem;
            font-size:.7rem;color:#cbd5e1;line-height:1.7;
        }
        .notice strong{color:#a78bfa}

        /* FEEDBACK */
        .status-msg{
            background:#1e293b;border-radius:1rem;padding:.6rem 1rem;
            margin:.5rem 0;font-size:.72rem;text-align:center;color:#a78bfa;
            display:none;
        }
        .status-msg.show{display:block}
        .phase-info{
            font-size:.7rem;color:#94a3b8;margin-top:.5rem;text-align:center;
            padding:.6rem;background:rgba(0,0,0,.25);border-radius:.6rem;
        }

        /* ULTRA STATS */
        .ultra-stats{
            background:rgba(206,66,43,.08);border-radius:.6rem;padding:.6rem;
            margin-top:.75rem;font-size:.63rem;color:#94a3b8;
            display:flex;flex-wrap:wrap;gap:6px;
        }
        .ultra-stats span{background:rgba(0,0,0,.3);padding:3px 9px;border-radius:10px}
        .ultra-stats strong{color:#eef2ff}

        /* WIDGETS */
        .widgets{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px;margin-bottom:1rem}
        .widget{
            background:rgba(26,37,48,.85);border:1px solid #8b5cf6;
            border-radius:12px;padding:15px;transition:.3s;
        }
        .widget:hover{border-color:#a78bfa;box-shadow:0 0 25px rgba(139,92,246,.15)}
        .widget-title{
            font-weight:700;color:#a78bfa;font-size:.8rem;margin-bottom:10px;
            display:flex;align-items:center;gap:8px;
        }
        .widget-content{font-size:.82rem;line-height:1.6;color:#f0f4f8}
        .conf-row{display:flex;align-items:center;gap:10px;margin-top:8px;padding:8px;background:rgba(0,0,0,.3);border-radius:8px}
        .conf-track{flex:1;height:4px;background:#2c3a4a;border-radius:2px;overflow:hidden}
        .conf-fill{height:100%;background:linear-gradient(90deg,#f59e0b,#10b981);width:0;transition:width 1s ease}
        .conf-label{font-size:.7rem;color:#b0c4de;min-width:40px;font-weight:700}
        .connector-metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:10px}
        .cm{background:rgba(0,0,0,.3);padding:8px;border-radius:6px;text-align:center}
        .cm .v{font-size:1rem;font-weight:700;color:#a78bfa}
        .cm .l{font-size:.55rem;color:#94a3b8;margin-top:2px}
        .chip{
            display:inline-block;background:#2c3a4a;padding:3px 10px;
            border-radius:15px;font-size:.65rem;border:1px solid #8b5cf6;
            margin:2px;color:#c4b5fd;
        }
        .kw-chip{
            background:#2c3a4a;padding:3px 10px;border-radius:12px;
            font-size:.6rem;border:1px solid #f59e0b;color:#f59e0b;
            margin:2px;display:inline-block;
        }

        /* RESULTS */
        .results{
            background:rgba(30,41,59,.6);backdrop-filter:blur(10px);
            border-radius:1.5rem;padding:1.5rem;
            border:1px solid rgba(139,92,246,.3);display:none;
            box-shadow:0 0 40px rgba(139,92,246,.1);
        }
        .results.show{display:block}
        .section-title{
            font-size:1rem;font-weight:700;margin-bottom:1rem;
            border-left:4px solid #8b5cf6;padding-left:1rem;
            color:#eef2ff;
        }
        .content-box{
            background:rgba(15,23,42,.6);border-radius:1rem;
            padding:1.2rem;margin-bottom:1.5rem;line-height:1.8;
            white-space:pre-wrap;max-height:600px;overflow-y:auto;
            font-size:.9rem;border:1px solid rgba(139,92,246,.2);
        }
        .cite-box{
            background:rgba(139,92,246,.15);border-left:4px solid #8b5cf6;
            padding:1rem;border-radius:.8rem;margin-bottom:1.5rem;
            font-family:monospace;font-size:.82rem;
        }
        .bib-list{
            background:rgba(15,23,42,.6);border-radius:1rem;
            padding:1.2rem;max-height:300px;overflow-y:auto;
        }
        .bib-item{
            padding:.8rem 0 .8rem 2rem;border-bottom:1px solid #334155;
            font-size:.78rem;text-indent:-2rem;margin-left:2rem;
            line-height:1.6;
        }
        .bib-item:last-child{border-bottom:none}
        .bib-item a{color:#60a5fa;text-decoration:none;margin-left:6px;font-size:.7rem}
        .bib-item a:hover{text-decoration:underline}
        .copy-btn{
            background:#475569;border:none;padding:.5rem 1rem;
            border-radius:2rem;color:#fff;cursor:pointer;font-size:.7rem;
            margin-top:.5rem;margin-left:.5rem;transition:.2s;
        }
        .copy-btn:hover{background:#8b5cf6}

        /* FOOTER */
        .footer{text-align:center;padding:1.5rem 1rem;color:#64748b;font-size:.68rem;margin-top:2rem;border-top:1px solid rgba(139,92,246,.15)}

        /* MODAL */
        .modal-bg{
            position:fixed;inset:0;background:rgba(0,0,0,.95);z-index:9999;
            display:flex;align-items:center;justify-content:center;padding:1rem;
            backdrop-filter:blur(6px);
        }
        .modal-box{
            background:#0f172a;border-radius:1.5rem;max-width:720px;width:100%;
            max-height:85vh;overflow-y:auto;padding:1.5rem;
            border:2px solid #8b5cf6;box-shadow:0 0 60px rgba(139,92,246,.3);
        }
        .modal-box h3{
            font-size:1rem;color:#a78bfa;margin-bottom:1rem;
            padding-bottom:.75rem;border-bottom:1px solid rgba(139,92,246,.3);
        }
        .modal-body{
            font-size:.85rem;line-height:1.8;color:#eef2ff;
            white-space:pre-wrap;font-family:inherit;
        }
        .modal-close{
            margin-top:1rem;background:linear-gradient(90deg,#8b5cf6,#3b82f6);
            border:none;padding:.6rem 1.4rem;border-radius:2rem;color:#fff;
            cursor:pointer;font-weight:600;font-size:.8rem;
        }

        /* TOAST */
        .toast{
            position:fixed;bottom:24px;left:50%;transform:translateX(-50%);
            background:linear-gradient(90deg,#8b5cf6,#3b82f6);color:#fff;
            padding:.75rem 1.5rem;border-radius:50px;font-size:.78rem;
            z-index:10000;box-shadow:0 10px 40px rgba(139,92,246,.5);
            animation:toastIn .3s ease;max-width:90%;text-align:center;
        }
        .toast.error{background:linear-gradient(90deg,#ef4444,#dc2626)}
        @keyframes toastIn{from{opacity:0;transform:translate(-50%,20px)}to{opacity:1;transform:translate(-50%,0)}}

        /* SPINNER */
        .spinner{
            display:inline-block;width:12px;height:12px;
            border:2px solid rgba(255,255,255,.3);border-top-color:#fff;
            border-radius:50%;animation:spin .6s linear infinite;
            vertical-align:middle;margin-right:6px;
        }
        @keyframes spin{to{transform:rotate(360deg)}}

        /* RESPONSIVE */
        @media(max-width:700px){
            h1{font-size:1.4rem}
            .main-card{padding:1rem}
            .widgets{grid-template-columns:1fr}
            .connector-metrics{grid-template-columns:repeat(2,1fr)}
            .input-row{flex-direction:column}
            .input-text{width:100%}
        }
    </style>
</head>
<body>
<div class="app">

    <header class="header">
        <h1>📚 AcadémIA Pro 
            <span class="badge b-experto">🧠 EXPERTO</span>
            <span class="badge b-basico">⚡ BÁSICO</span>
            <span class="badge b-12f">🔬 12 FUENTES</span>
            <span class="badge b-decide">🧠 DECIDE</span>
            <span class="badge b-alemania">🇩🇪 ENFOQUE ALEMÁN</span>
            <span class="badge b-wasm">⚡ WASM RUST</span>
            <span class="badge b-core">🧬 CORE 403M</span>
            <span class="badge b-agent">🔌 AGENT-REACH</span>
            <span class="badge b-multiia">🔄 MULTI-IA</span>
            <span class="badge b-multi">🌐 MULTILINGÜE</span>
            <span class="badge b-analytics">📊 AI ANALYTICS</span>
            <span class="badge b-1llamada">⚡ 1 LLAMADA</span>
            <span class="badge b-100f">🚀 100+ FUNCIONES</span>
            <span class="badge b-agente">🤖 AGENTE</span>
            <span class="badge b-ilim">♾️ ILIMITADO</span>
        </h1>
        <div class="sub">Core 403M · Agent-Reach · 12 Fuentes + Ilimitadas · APA 7 · WebAssembly Rust REAL · Multi-IA (9 proveedores en paralelo) · 🇩🇪 Enfoque Alemán · 🌐 Multilingüe · 📊 Análisis Automático · ⚡ 1 sola llamada · 🚀 100+ funciones Rust · ♾️ Sin límites</div>
        <div class="daily">⚡ WebAssembly Rust REAL · 50x más rápido · 🔄 Multi-IA paralelo con Promise.any · 🧠 Fallback académico con 12 fuentes reales · 🔌 Agent-Reach · 🧬 Core 403M auto-evolutivo · 🌐 Detección de idioma · 📊 Análisis automático · ♾️ Sin límites</div>
    </header>

    <!-- STATUS BARS -->
    <div class="status-strip">
        <div class="status-row rust">
            <span class="lbl">🦀 WASM Rust:</span>
            <span class="item"><strong id="rustStatus">⏳ Cargando…</strong></span>
            <span class="item">📊 Funciones: <strong id="rustFuncCount">0</strong></span>
            <span class="item">⏱️ Tiempo: <strong id="rustTiempo">0ms</strong></span>
            <span class="item">📦 Caché: <strong id="rustCache">0</strong></span>
            <span class="item">🧠 <strong id="rustVersion">—</strong></span>
        </div>
        <div class="status-row core">
            <span class="lbl">🧬 Core 403M:</span>
            <span class="item"><strong id="coreStatus" class="ok">⏳ Iniciando…</strong></span>
            <span class="item">📡 Consultas: <strong id="coreConsultas">0</strong></span>
            <span class="item">📚 Temas: <strong id="coreTemas">0</strong></span>
            <span class="item">🔄 Evoluciones: <strong id="coreEvoluciones">0</strong></span>
        </div>
        <div class="status-row ar">
            <span class="lbl">🔌 Agent-Reach:</span>
            <span class="item"><strong id="arStatus" class="ok">⏳ Iniciando…</strong></span>
            <span class="item">📦 GitHub <strong id="arGitHub">0</strong></span>
            <span class="item">📖 Reddit <strong id="arReddit">0</strong></span>
            <span class="item">🌐 Wiki <strong id="arWiki">0</strong></span>
        </div>
        <div class="status-row core">
            <span class="lbl">🔄 Multi-IA:</span>
            <span class="item"><strong id="multiIaStatus" class="ok">⏳ Esperando…</strong></span>
            <span class="item">✅ OK: <strong id="iaOkCount">0</strong></span>
            <span class="item">❌ Fallos: <strong id="iaFailsCount">0</strong></span>
        </div>
    </div>

    <!-- TOP BAR -->
    <div class="top-bar">
        <div class="mode-group">
            <button class="mode-btn active" data-modo="experto">🧠 EXPERTO</button>
            <button class="mode-btn" data-modo="basico">⚡ BÁSICO</button>
        </div>
        <div class="mode-group" style="margin-left:8px;">
